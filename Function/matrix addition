#include <stdio.h>

void add(int a[10][10], int b[10][10],
         int c[10][10], int sum[10][10],
         int r, int col)
{
    int i, j;

    for (i = 0; i < r; i++)
    {
        for (j = 0; j < col; j++)
        {
            sum[i][j] = a[i][j] + b[i][j] + c[i][j];
        }
    }
}

int main()
{
    int a[10][10], b[10][10], c[10][10];
    int sum[10][10];
    int r, col, i, j;

    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &col);

    if (r < 1 || r > 10 || col < 1 || col > 10)
    {
        printf("Invalid matrix size.\n");
        return 0;
    }

    printf("Enter elements of first matrix:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < col; j++)
            scanf("%d", &a[i][j]);

    printf("Enter elements of second matrix:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < col; j++)
            scanf("%d", &b[i][j]);

    printf("Enter elements of third matrix:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < col; j++)
            scanf("%d", &c[i][j]);

    add(a, b, c, sum, r, col);

    printf("Sum of three matrices:\n");
    for (i = 0; i < r; i++)
    {
        for (j = 0; j < col; j++)
            printf("%d ", sum[i][j]);

        printf("\n");
    }

    return 0;
}
